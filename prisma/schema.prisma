
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(cuid())

  name String
  avatar String?
  avatarPublicId String?

  username String @unique
  email         String   @unique

  password      String?

  isEmailVerified    Boolean  @default(false)
  isActive      Boolean  @default(true)

  role          UserRole     @default(EMPLOYEE)
  
  lastLoginAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  isVerified Boolean @default(false)
  verifiedAt DateTime?
  verifiedById String?

  emailVerificationToken String?
  emailVerificationTokenExpiry DateTime?

  accounts Account[]

  organizationMembers OrganizationMember[]
  organizationInvites OrganizationInvite[] @relation("OrganizationInvite_invitedBy")
  organizationInvitesRevoked OrganizationInvite[] @relation("OrganizationInvite_revokedBy")

  workspacesCreated Workspace[]
  workspaceMembers WorkspaceMember[]

  projectMembers ProjectMember[]
  projects Project[]

  tasksAssigned TaskAssignee[] @relation("TaskAssigner")
  tasksAssignee TaskAssignee[] @relation("TaskAssignee")

  reviewRequestsSent TaskReviewRequest[] @relation("TaskReviewRequester")
  reviewRecipients TaskReviewRecipient[] @relation("TaskReviewRecipient")

  contributionRequestsSent TaskContributionRequest[] @relation("ContributionRequester")
  contributionRequestsReceived TaskContributionRequest[] @relation("ContributionReviewer")

  contributionsVerified TaskContribution[] @relation("TaskContributionVerifier")
  contributions TaskContribution[]

  workspacesArchived   Workspace[] @relation("WorkspaceArchivedBy")

  posts        Post[] @relation("UserPosts")
  reactions    PostReaction[] @relation("UserPostReactions")
  comments     PostComment[]  @relation("UserPostComments")

  profile Profile?
  onboarding UserOnboarding?

  selectedOrganizationId String?
  selectedOrganization  Organization? @relation("UserSelectedOrganization",fields: [selectedOrganizationId],references: [id],onDelete: SetNull)

  selectedWorkspaceId String?
  selectedWorkspace  Workspace? @relation("UserSelectedWorkspace",fields: [selectedWorkspaceId],references: [id],onDelete: SetNull)
  
  connectionsAsUserOne Connection[] @relation("ConnectionUserOne")
  connectionsAsUserTwo Connection[] @relation("ConnectionUserTwo")

  sentConnectionRequests     ConnectionRequest[] @relation("ConnectionRequestSender")
  receivedConnectionRequests ConnectionRequest[] @relation("ConnectionRequestReceiver")

  notificationsReceived Notification[] @relation("NotificationRecipient")
  notificationsSent     Notification[] @relation("NotificationActor")

  activities Activity[] @relation("ActivityActor")

  @@index([username])
  @@index([email])
}

model Connection {
  id        String   @id @default(cuid())

  userOneId String
  userTwoId String

  userOne   User     @relation("ConnectionUserOne", fields: [userOneId], references: [id], onDelete: Cascade)
  userTwo   User     @relation("ConnectionUserTwo", fields: [userTwoId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userOneId, userTwoId])
  @@index([userOneId])
  @@index([userTwoId])
  @@map("connections")
}

model ConnectionRequest {
  id         String                  @id @default(cuid())

  senderId   String
  receiverId String
  status     ConnectionRequestStatus @default(PENDING)

  message String? @db.VarChar(500)

  sender     User                    @relation("ConnectionRequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver   User                    @relation("ConnectionRequestReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt
  respondedAt DateTime?

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
  @@index([senderId, status])
  @@map("connection_requests")
}

enum ConnectionRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

model Account {
  id                 String   @id @default(cuid())

  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider           AuthProvider
  providerAccountId  String

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([provider, providerAccountId])
}

enum AuthProvider {
  CREDENTIALS
  GOOGLE
}


enum UserRole {
  ADMIN
  EMPLOYEE
}

model Profile {
  id String @id @default(cuid())

  userId String @unique
  user User @relation(fields: [userId],references: [id],onDelete: Cascade)

  headline String? @db.VarChar(200)
  profession String? @db.VarChar(100)
  industry String? @db.VarChar(100)
  bio String? @db.Text

   city String?
  state String?
  country String?

  website String?
  linkedinUrl String?
  githubUrl String?

  skills Skill[]

  educations Education[]
  experiences Experience[]

  isOpenToWork Boolean @default(false)
  isOpenToCollaborate Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Education {
  id String @id @default(cuid())

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  institution String
  degree      String?
  fieldOfStudy String?

  startDate DateTime?
  endDate   DateTime?

  grade String?
  description String? @db.Text

  isCurrentlyStudying Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
}

model Experience {
  id String @id @default(cuid())

  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  company String
  position String
  employmentType EmploymentType?

  startDate DateTime
  endDate DateTime?
  isCurrentlyWorking Boolean @default(false)

  location String?
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  FREELANCE
  SELF_EMPLOYED
  APPRENTICESHIP
  OTHER
}

model UserOnboarding {
  id String @id @default(cuid())

  userId String @unique
  user User @relation(  fields: [userId],  references: [id],  onDelete: Cascade)

  currentStep OnboardingStep @default(BASIC_INFO)
  isCompleted Boolean @default(false)
  completedAt DateTime?

  basicInfoCompleted Boolean @default(false)
  professionalInfoCompleted Boolean @default(false)
  experienceInfoCompleted Boolean @default(false)
  summaryCompleted Boolean @default(false)
  locationInfoCompleted Boolean @default(false)
  skillsCompleted Boolean @default(false)
  educationInfoCompleted Boolean @default(false)
  availabilityInfoCompleted Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum OnboardingStep {
  BASIC_INFO
  PROFESSIONAL
  EXPERIENCE
  SUMMARY
  LOCATION
  SKILLS
  EDUCATION
  AVAILABILITY
  COMPLETED
}


model Skill {
  id String @id @default(cuid())

  name String @unique
  slug String @unique

  profiles Profile[]
}

model Organization {
  id          String   @id @default(cuid())

  name        String
  slug        String   @unique
  supportEmail       String
  description String?
  website     String?
  logo        String?

  isActive      Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  organizationMembers OrganizationMember[]
  organizationInvites OrganizationInvite[]
  workspaces Workspace[]
  projects Project[]
  tasks Task[]

  selectedByUsers       User[] @relation("UserSelectedOrganization")

  activities Activity[]
}

model OrganizationMember {
  id String @id @default(cuid())

  userId         String
  organizationId String

  role OrganizationMemberRole @default(MEMBER)
  department     String?
  designation    String?

  isActive Boolean @default(true)

  joinedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)


  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
}

model OrganizationInvite {
  id String @id @default(cuid())

  email String

  organizationId String
  invitedById    String
  revokedById    String?

  role OrganizationMemberRole @default(MEMBER)
  status OrganizationInviteStatus @default(PENDING)
  
  department     String?
  designation    String?

  token       String   @unique
  expiresAt   DateTime

  acceptedAt DateTime?
  revokedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy User @relation("OrganizationInvite_invitedBy", fields: [invitedById], references: [id], onDelete: Cascade)
  revokedBy User? @relation("OrganizationInvite_revokedBy", fields: [revokedById], references: [id], onDelete: SetNull)
  

  @@index([organizationId])
  @@index([email])
}

enum OrganizationInviteStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
  REVOKED
}

enum OrganizationMemberRole {
  OWNER
  ADMIN
  RECRUITER
  MANAGER
  MEMBER
}
  

model Workspace {
  id             String   @id @default(cuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId],references: [id],onDelete: Cascade)

  name        String
  slug        String
  description String?
  logo        String?

  status      WorkspaceStatus @default(ACTIVE)

  archivedAt  DateTime?
  archivedById String?
  archivedBy   User?            @relation("WorkspaceArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)

  createdById String
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members  WorkspaceMember[]
  projects Project[]

  selectedByUsers       User[] @relation("UserSelectedWorkspace")

  @@unique([organizationId, slug])
  @@index([organizationId])
}

enum WorkspaceStatus {
  ACTIVE
  ARCHIVED
}

model WorkspaceMember {
  id          String @id @default(cuid())

  workspaceId String
  userId      String

  role  WorkspaceMemberRole @default(MEMBER)

  workspace Workspace @relation(fields: [workspaceId],references: [id],onDelete: Cascade)

  user User @relation(fields: [userId],references: [id],onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, userId])
  @@index([userId])
}

enum WorkspaceMemberRole {
  ADMIN
  MEMBER
}

model Project {
  id          String   @id @default(cuid())

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId],references: [id],onDelete: Cascade)

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  name        String
  slug        String
  description String?

  status      ProjectStatus @default(ACTIVE)

  startDate   DateTime?
  dueDate     DateTime?

  createdById String
  createdBy   User @relation(fields: [createdById],references: [id],onDelete: Restrict)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tasks       Task[]
  members     ProjectMember[]

  @@unique([workspaceId, slug])
  @@index([organizationId])
  @@index([workspaceId])
  @@index([createdById])
}

model ProjectMember {
  id          String @id @default(cuid())

  projectId   String
  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId      String
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  role        ProjectMemberRole @default(MEMBER)

  joinedAt    DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([projectId, userId])
  @@index([userId])
}

enum ProjectMemberRole {
  ADMIN
  MEMBER
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
  ARCHIVED
}

model Task {
  id          String      @id @default(cuid())
  title       String
  description String?

  status      TaskStatus  @default(TODO)
  priority    TaskPriority    @default(MEDIUM)

  startDate   DateTime?
  dueDate     DateTime?
  completedAt DateTime?

  labels String[] @default([])

  projectId   String?
  project     Project?    @relation(fields: [projectId], references: [id])

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  assignees TaskAssignee[]

  reviewRecipients TaskReviewRecipient[]
  reviewRequests   TaskReviewRequest[]

  contributionRequests TaskContributionRequest[]
  contributions        TaskContribution[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([projectId])
}

model TaskAssignee {
  id        String @id @default(cuid())

  taskId    String
  task      Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  memberId  String
  member    User @relation("TaskAssignee", fields: [memberId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  assignerId String
  assigner   User @relation("TaskAssigner", fields: [assignerId], references: [id], onDelete: Cascade)

  @@unique([taskId, memberId])
  @@index([memberId])
  @@index([taskId])
}


model TaskReviewRecipient {
  id String @id @default(cuid())

  taskId String
  task   Task @relation(fields: [taskId],references: [id],onDelete: Cascade)

  memberId String
  member   User @relation("TaskReviewRecipient",fields: [memberId],references: [id],onDelete: Cascade)

  isDefault Boolean @default(false)

  createdAt DateTime @default(now())

  @@unique([taskId, memberId])
  @@index([taskId])
  @@index([memberId])
}

model TaskReviewRequest {
  id String @id @default(cuid())

  taskId String
  task   Task @relation(fields: [taskId],references: [id],onDelete: Cascade)

  requesterId String
  requester   User @relation("TaskReviewRequester",fields: [requesterId],references: [id],onDelete: Cascade)

  status TaskReviewStatus @default(PENDING)

  message String?

  requestedAt DateTime @default(now())
  reviewedAt  DateTime?

  @@index([taskId])
  @@index([requesterId])
}

enum TaskReviewStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  ESCALATED
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model TaskContributionRequest {
  id String @id @default(cuid())

  taskId String
  task   Task @relation(fields: [taskId],references: [id],onDelete: Cascade)

  requesterId String
  requester   User @relation("ContributionRequester",fields: [requesterId],references: [id])

  reviewerId String?
  reviewer   User? @relation("ContributionReviewer",fields: [reviewerId],references: [id])


  contribution String

  status ContributionStatus @default(PENDING)

  message  String?
  feedback String?

  requestedAt DateTime @default(now())
  reviewedAt DateTime?

  contributionRecord TaskContribution?


  @@index([taskId])
  @@index([requesterId])
    @@index([reviewerId])

}

model TaskContribution {
  id String @id @default(cuid())

  taskId String
  task   Task @relation(fields: [taskId],references: [id],onDelete: Cascade)

  userId String
  user   User @relation(fields: [userId],references: [id],onDelete: Cascade)

  contribution String

  visibility ContributionVisibility @default(PRIVATE)

  verifiedById String
  verifiedBy   User @relation("TaskContributionVerifier",fields: [verifiedById],references: [id])

  verifiedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requestId String @unique
  request   TaskContributionRequest @relation(fields: [requestId],references: [id])

  @@index([taskId])
  @@index([userId])
  @@index([verifiedById])
}

enum ContributionVisibility {
  PRIVATE
  ORGANIZATION
  PUBLIC
}

enum ContributionStatus {
  PENDING
  APPROVED
  REJECTED
}



model Post {
  id        String   @id @default(uuid())
  content   String?  @db.Text

  commentPermission PostCommentPermission @default(EVERYONE)

  visibility PostVisibility @default(PUBLIC)
  status     PostStatus     @default(PUBLISHED)

  authorId String
  author   User   @relation("UserPosts", fields: [authorId], references: [id], onDelete: Cascade)

  media     PostMedia[]
  reactions PostReaction[]
  comments  PostComment[]

  hashtags PostHashtag[]


  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([authorId])

  @@index([status, visibility])
  @@index([createdAt])
}

enum PostMediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

enum PostCommentPermission {
  EVERYONE
  CONNECTIONS
  NO_ONE
}

model PostMedia {
  id String @id @default(uuid())

  type PostMediaType

  url      String
  publicId String?

  fileName String?
  fileSize Int?

  position Int @default(0)


  postId String
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([postId])
}


enum PostVisibility {
  PUBLIC
  CONNECTIONS
  PRIVATE
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  DELETED
}

enum PostReactionType {
  LIKE
  INSIGHTFUL
  CELEBRATE
  SUPPORT
}

model PostReaction {
  id String @id @default(uuid())

  type PostReactionType

  postId String
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  userId String
  user   User @relation("UserPostReactions",fields: [userId],references: [id],onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([userId])
}

model PostComment {
  id      String @id @default(uuid())
  content String @db.Text

  postId String
  post   Post @relation(fields: [postId],references: [id],onDelete: Cascade)

  authorId String
  author   User @relation("UserPostComments",fields: [authorId],references: [id],onDelete: Cascade)

  parentId String?
  parent   PostComment? @relation("CommentReplies",fields: [parentId],references: [id],onDelete: Cascade)

  replies PostComment[] @relation("CommentReplies")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
  @@index([authorId])
  @@index([parentId])
}

model Hashtag {
  id String @id @default(uuid())

  name String @unique
  slug String @unique

  posts PostHashtag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

model PostHashtag {
  postId String
  hashtagId String

  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  hashtag Hashtag @relation(fields: [hashtagId], references: [id], onDelete: Cascade)

  @@id([postId, hashtagId])

  @@index([hashtagId])
}


enum NotificationType {
  ORGANIZATION_INVITE
  ORGANIZATION_JOINED
  ORGANIZATION_ROLE_CHANGED
  ORGANIZATION_REMOVED

  WORKSPACE_MEMBER_ADDED
  WORKSPACE_ROLE_CHANGED

  PROJECT_MEMBER_ADDED
  PROJECT_ROLE_CHANGED

  TASK_ASSIGNED
  TASK_UNASSIGNED
  TASK_DUE_SOON
  TASK_OVERDUE
  TASK_STATUS_CHANGED
  TASK_REVIEW_REQUESTED
  TASK_REVIEW_COMPLETED
  TASK_COMMENT_ADDED
  CONTRIBUTION_REQUESTED
  CONTRIBUTION_VERIFIED

  CONNECTION_REQUEST_RECEIVED
  CONNECTION_REQUEST_ACCEPTED
  CONNECTION_REQUEST_DECLINED

  NEW_MESSAGE
  GROUP_MESSAGE
  MENTIONED

  POST_REACTION
  POST_COMMENT
  COMMENT_REPLY

  ACCOUNT_VERIFIED
  SECURITY_ALERT
}

model Notification {
  id          String           @id @default(cuid())
  type        NotificationType

  recipientId String
  actorId     String?

  title       String           @db.VarChar(200)
  message     String           @db.VarChar(1000)

  entityType  String?          @db.VarChar(50)
  entityId    String?
  actionUrl   String?          @db.VarChar(500)

  data        Json?

  readAt      DateTime?
  createdAt   DateTime         @default(now())
  expiresAt   DateTime?

  recipient   User @relation("NotificationRecipient",fields: [recipientId],references: [id],onDelete: Cascade)

  actor       User? @relation("NotificationActor",fields: [actorId],references: [id],onDelete: SetNull)

  @@index([recipientId, readAt, createdAt])
  @@index([recipientId, createdAt])
  @@index([entityType, entityId])
  @@map("notifications")
}


enum ActivityType {
  ORGANIZATION_CREATED
  ORGANIZATION_MEMBER_JOINED
  ORGANIZATION_MEMBER_REMOVED
  ORGANIZATION_ROLE_CHANGED

  WORKSPACE_CREATED
  WORKSPACE_UPDATED
  WORKSPACE_ARCHIVED
  WORKSPACE_MEMBER_ADDED
  WORKSPACE_MEMBER_REMOVED

  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_STATUS_CHANGED
  PROJECT_MEMBER_ADDED
  PROJECT_MEMBER_REMOVED

  TASK_CREATED
  TASK_UPDATED
  TASK_STATUS_CHANGED
  TASK_PRIORITY_CHANGED
  TASK_ASSIGNED
  TASK_UNASSIGNED
  TASK_DUE_DATE_CHANGED
  TASK_COMPLETED

  REVIEW_REQUESTED
  REVIEW_APPROVED
  REVIEW_CHANGES_REQUESTED
  CONTRIBUTION_SUBMITTED
  CONTRIBUTION_VERIFIED
  CONTRIBUTION_REJECTED

  CONNECTION_REQUEST_SENT
  CONNECTION_REQUEST_ACCEPTED
  CONNECTION_REQUEST_DECLINED

  POST_CREATED
  POST_UPDATED
  POST_DELETED
  POST_COMMENTED
  POST_REACTED

  PROFILE_UPDATED
  ACCOUNT_VERIFIED
}

model Activity {
  id             String       @id @default(cuid())
  type           ActivityType

  actorId        String?
  organizationId String?

  entityType     String       @db.VarChar(50)
  entityId       String

  description    String?      @db.VarChar(500)
  metadata       Json?

  createdAt      DateTime     @default(now())

  actor User? @relation("ActivityActor",fields: [actorId],references: [id],onDelete: SetNull)

  organization Organization? @relation(fields: [organizationId],references: [id],onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([type, createdAt])
  @@map("activities")
}

