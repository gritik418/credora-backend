<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <meta http-equiv='X-UA-Compatible' content='IE=edge' />

    <title>Verify {{name}} on Credora</title>
  </head>

  <body
    style="
      margin: 0;
      padding: 0;
      min-width: 100%;
      background-color: #f1f5f9;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto,
        'Helvetica Neue', Arial, sans-serif;
      color: #0f172a;
    "
  >
    <table
      role='presentation'
      width='100%'
      cellpadding='0'
      cellspacing='0'
      border='0'
      style='background-color: #f1f5f9; padding: 40px 16px;'
    >
      <tr>
        <td align='center'>

          <!-- Main Container -->
          <table
            role='presentation'
            width='100%'
            cellpadding='0'
            cellspacing='0'
            border='0'
            style='
              max-width: 620px;
              background-color: #ffffff;
              border-radius: 14px;
              overflow: hidden;
              border: 1px solid #e2e8f0;
              box-shadow: 0 10px 30px rgba(15, 23, 42, 0.08);
            '
          >

            <!-- Platform Header -->
            <tr>
              <td
                style='
                  padding: 28px 40px;
                  border-bottom: 1px solid #e2e8f0;
                  background-color: #ffffff;
                '
              >
                <table
                  role='presentation'
                  width='100%'
                  cellpadding='0'
                  cellspacing='0'
                  border='0'
                >
                  <tr>
                    <td align='left'>
                      <img
                        src='{{logoUrl}}'
                        alt='Credora'
                        style='
                          display: block;
                          width: 110px;
                          height: auto;
                          border-radius: 6px;
                        '
                      />
                    </td>

                    <td
                      align='right'
                      style='
                        font-size: 12px;
                        color: #64748b;
                        font-weight: 500;
                      '
                    >
                      Organization Verification
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Organization Header -->
            <tr>
              <td
                style='
                  padding: 36px 40px 28px;
                  background: linear-gradient(
                    180deg,
                    #f8fafc 0%,
                    #ffffff 100%
                  );
                  text-align: center;
                '
              >
                {{#if logo}}
                  <img
                    src='{{logo}}'
                    alt='{{name}}'
                    style='
                      display: block;
                      width: 72px;
                      height: 72px;
                      object-fit: contain;
                      margin: 0 auto 18px;
                      border-radius: 12px;
                      border: 1px solid #e2e8f0;
                      background-color: #ffffff;
                    '
                  />
                {{else}}
                  <div
                    style='
                      width: 72px;
                      height: 72px;
                      margin: 0 auto 18px;
                      border-radius: 12px;
                      background-color: #eff6ff;
                      border: 1px solid #dbeafe;
                      line-height: 72px;
                      font-size: 28px;
                      font-weight: 700;
                      color: #2563eb;
                    '
                  >
                    {{name.[0]}}
                  </div>
                {{/if}}

                <h1
                  style='
                    margin: 0 0 8px;
                    font-size: 26px;
                    line-height: 1.25;
                    font-weight: 700;
                    color: #0f172a;
                    letter-spacing: -0.4px;
                  '
                >
                  Verify your organization
                </h1>

                <p
                  style='
                    margin: 0;
                    font-size: 15px;
                    line-height: 1.6;
                    color: #64748b;
                  '
                >
                  Confirm the email address for
                  <strong style='color: #334155;'>
                    {{name}}
                  </strong>
                  to complete your organization setup on Credora.
                </p>
              </td>
            </tr>

            <!-- Organization Details -->
            <tr>
              <td style='padding: 0 40px 28px;'>
                <table
                  role='presentation'
                  width='100%'
                  cellpadding='0'
                  cellspacing='0'
                  border='0'
                  style='
                    background-color: #f8fafc;
                    border: 1px solid #e2e8f0;
                    border-radius: 10px;
                  '
                >
                  <tr>
                    <td style='padding: 20px 22px;'>

                      <p
                        style='
                          margin: 0 0 14px;
                          font-size: 11px;
                          line-height: 1.4;
                          color: #64748b;
                          font-weight: 700;
                          text-transform: uppercase;
                          letter-spacing: 0.7px;
                        '
                      >
                        Organization details
                      </p>

                      <table
                        role='presentation'
                        width='100%'
                        cellpadding='0'
                        cellspacing='0'
                        border='0'
                      >
                        <tr>
                          <td
                            style='
                              padding-bottom: 10px;
                              font-size: 13px;
                              color: #64748b;
                              width: 100px;
                            '
                          >
                            Name
                          </td>

                          <td
                            style='
                              padding-bottom: 10px;
                              font-size: 13px;
                              color: #0f172a;
                              font-weight: 600;
                            '
                          >
                            {{name}}
                          </td>
                        </tr>

                        <tr>
                          <td
                            style='
                              padding-bottom: 10px;
                              font-size: 13px;
                              color: #64748b;
                            '
                          >
                            Identifier
                          </td>

                          <td
                            style="
                              padding-bottom: 10px;
                              font-size: 13px;
                              color: #334155;
                              font-family: 'SF Mono', Monaco, 'Courier New',
                                monospace;
                            "
                          >
                            {{slug}}
                          </td>
                        </tr>

                        <tr>
                          <td
                            style='
                              font-size: 13px;
                              color: #64748b;
                            '
                          >
                            Email
                          </td>

                          <td
                            style='
                              font-size: 13px;
                              color: #334155;
                            '
                          >
                            {{email}}
                          </td>
                        </tr>
                      </table>

                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Description -->
            {{#if description}}
              <tr>
                <td style='padding: 0 40px 28px;'>
                  <p
                    style='
                      margin: 0;
                      font-size: 14px;
                      line-height: 1.7;
                      color: #64748b;
                      text-align: center;
                    '
                  >
                    {{description}}
                  </p>
                </td>
              </tr>
            {{/if}}

            <!-- Verification -->
            <tr>
              <td
                style='
                  padding: 4px 40px 36px;
                  text-align: center;
                '
              >
                <h2
                  style='
                    margin: 0 0 10px;
                    font-size: 20px;
                    line-height: 1.3;
                    font-weight: 700;
                    color: #0f172a;
                  '
                >
                  Confirm your email address
                </h2>

                <p
                  style='
                    margin: 0 auto 24px;
                    max-width: 470px;
                    font-size: 14px;
                    line-height: 1.6;
                    color: #64748b;
                  '
                >
                  Verify your organization email address to activate your
                  Credora organization account.
                </p>

                <!-- CTA -->
                <table
                  role='presentation'
                  cellpadding='0'
                  cellspacing='0'
                  border='0'
                  style='margin: 0 auto 22px;'
                >
                  <tr>
                    <td
                      align='center'
                      style='
                        border-radius: 8px;
                        background-color: #2563eb;
                      '
                    >
                      <a
                        href='{{verificationLink}}'
                        style='
                          display: inline-block;
                          padding: 14px 34px;
                          font-size: 14px;
                          line-height: 1.5;
                          font-weight: 600;
                          color: #ffffff;
                          text-decoration: none;
                          border-radius: 8px;
                        '
                      >
                        Verify Organization
                      </a>
                    </td>
                  </tr>
                </table>

                <!-- Expiry -->
                <div
                  style='
                    display: inline-block;
                    padding: 9px 14px;
                    background-color: #fffbeb;
                    border: 1px solid #fde68a;
                    border-radius: 7px;
                  '
                >
                  <p
                    style='
                      margin: 0;
                      font-size: 12px;
                      line-height: 1.5;
                      color: #92400e;
                    '
                  >
                    <strong>Verification required:</strong>
                    This link expires in 10 minutes.
                  </p>
                </div>
              </td>
            </tr>

            <!-- Fallback -->
            <tr>
              <td style='padding: 0 40px 36px;'>
                <div
                  style='
                    padding: 18px 20px;
                    background-color: #f8fafc;
                    border: 1px solid #e2e8f0;
                    border-radius: 8px;
                  '
                >
                  <p
                    style='
                      margin: 0 0 8px;
                      font-size: 11px;
                      line-height: 1.4;
                      color: #64748b;
                      font-weight: 700;
                      text-transform: uppercase;
                      letter-spacing: 0.6px;
                    '
                  >
                    Having trouble with the button?
                  </p>

                  <p
                    style="
                      margin: 0;
                      font-size: 11px;
                      line-height: 1.6;
                      color: #475569;
                      word-break: break-all;
                      font-family: 'SF Mono', Monaco, 'Courier New',
                        monospace;
                    "
                  >
                    {{verificationLink}}
                  </p>
                </div>
              </td>
            </tr>

            <!-- Website -->
            {{#if website}}
              <tr>
                <td
                  style='
                    padding: 0 40px 32px;
                    text-align: center;
                  '
                >
                  <a
                    href='{{website}}'
                    style='
                      font-size: 13px;
                      color: #2563eb;
                      text-decoration: none;
                      font-weight: 500;
                    '
                  >
                    Visit
                    {{name}}
                  </a>
                </td>
              </tr>
            {{/if}}

            <!-- Footer -->
            <tr>
              <td
                style='
                  padding: 28px 40px;
                  background-color: #f8fafc;
                  border-top: 1px solid #e2e8f0;
                  text-align: center;
                '
              >
                <p
                  style='
                    margin: 0 0 12px;
                    font-size: 12px;
                    line-height: 1.6;
                    color: #64748b;
                  '
                >
                  This email was sent by Credora as part of your organization
                  registration.
                </p>

                <div style='margin-bottom: 12px;'>
                  <a
                    href='{{clientUrl}}'
                    style='
                      margin: 0 8px;
                      font-size: 12px;
                      color: #64748b;
                      text-decoration: none;
                    '
                  >
                    Credora
                  </a>

                  <span style='color: #cbd5e1;'>•</span>

                  <a
                    href='{{clientUrl}}/privacy'
                    style='
                      margin: 0 8px;
                      font-size: 12px;
                      color: #64748b;
                      text-decoration: none;
                    '
                  >
                    Privacy
                  </a>

                  <span style='color: #cbd5e1;'>•</span>

                  <a
                    href='{{clientUrl}}/terms'
                    style='
                      margin: 0 8px;
                      font-size: 12px;
                      color: #64748b;
                      text-decoration: none;
                    '
                  >
                    Terms
                  </a>
                </div>

                <p
                  style='
                    margin: 0;
                    font-size: 11px;
                    color: #94a3b8;
                  '
                >
                  © 2026 Credora. All rights reserved.
                </p>
              </td>
            </tr>

          </table>

        </td>
      </tr>
    </table>
  </body>
</html>